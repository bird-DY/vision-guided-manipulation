<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="six_arm">
  <xacro:arg
    name="controllers_file"
    default="$(find mybot)/config/ros2_controllers.yaml"/>

  <xacro:include filename="$(find mybot_description)/urdf/six_arm.urdf"/>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <xacro:macro name="controlled_joint" params="joint_name">
      <joint name="${joint_name}">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>

    <xacro:controlled_joint joint_name="joint1"/>
    <xacro:controlled_joint joint_name="joint2"/>
    <xacro:controlled_joint joint_name="joint3"/>
    <xacro:controlled_joint joint_name="joint4"/>
    <xacro:controlled_joint joint_name="joint5"/>
    <xacro:controlled_joint joint_name="joint6"/>
    <xacro:controlled_joint joint_name="joint7"/>
    <xacro:controlled_joint joint_name="joint8"/>
  </ros2_control>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(arg controllers_file)</parameters>
      <robot_param_node>robot_state_publisher</robot_param_node>
    </plugin>
  </gazebo>
</robot>
